    <color name="emerald_500">#FF10B981</color>
    <color name="emerald_600">#FF059669</color>
    <color name="emerald_700">#FF047857</color>
    <color name="emerald_800">#FF065F46</color>
    <color name="emerald_900">#FF064E3B</color>
    <color name="emerald_950">#FF022C22</color>

    <!-- Neutrals (slightly green-tinted gray so surfaces feel part of the brand) -->
    <color name="neutral_0">#FFFFFFFF</color>
    <color name="neutral_50">#FFF6F8F7</color>
    <color name="neutral_100">#FFEEF2F0</color>
