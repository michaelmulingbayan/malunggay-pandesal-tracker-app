<?xml version="1.0" encoding="utf-8"?>
<!-- Rider › Stock: my stock flow (bar + list), return unsold stock, my returns. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl">

        <!-- ===== Header ===== -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_brand_header"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/my_stock_title"
                android:textAppearance="@style/TextAppearance.Malunggay.Display"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Tuesday, November 17" />
        </LinearLayout>

        <!-- ===== Stock flow ===== -->
        <LinearLayout
            style="@style/Malunggay.SectionCard.Padded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/assignedTotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    tools:text="500" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="@string/my_stock_assigned_label"
                    android:textAppearance="@style/TextAppearance.Malunggay.Body" />
            </LinearLayout>

            <com.example.malunggaytrackerapp.ui.common.StockFlowBarView
                android:id="@+id/flowBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical">

                <include
                    android:id="@+id/legendSold"
                    layout="@layout/item_legend" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="26dp"
                    android:background="?attr/colorOutlineVariant" />

                <include
                    android:id="@+id/legendReturned"
                    layout="@layout/item_legend" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="26dp"
                    android:background="?attr/colorOutlineVariant" />

                <include
                    android:id="@+id/legendRemaining"
                    layout="@layout/item_legend" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Return unsold stock ===== -->
        <TextView
            style="@style/Malunggay.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_stock_section_return" />

        <LinearLayout
            style="@style/Malunggay.SectionCard.Padded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- No quantity to type: riders hand back everything left at the end of their duty. -->
            <TextView
                android:id="@+id/returnLeftText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Malunggay.Title"
                tools:text="40 pcs left" />

            <TextView
                android:id="@+id/returnHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/my_stock_return_helper"
                android:textAppearance="@style/TextAppearance.Malunggay.Body" />

            <TextView
                android:id="@+id/returnErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.Malunggay.Body"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:text="Can't reach the server." />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/returnButton"
                    style="@style/Widget.Malunggay.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/my_stock_return_button" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/returnProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:elevation="8dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="24dp" />
            </FrameLayout>
        </LinearLayout>

        <!-- ===== My returns ===== -->
        <TextView
            style="@style/Malunggay.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_stock_section_returns" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/returnsList"
            style="@style/Malunggay.SectionCard.List"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="2"
            tools:listitem="@layout/item_my_activity" />

        <include
            android:id="@+id/returnsEmpty"
            layout="@layout/view_empty_state"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
