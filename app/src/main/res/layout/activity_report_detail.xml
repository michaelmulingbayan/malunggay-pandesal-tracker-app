<?xml version="1.0" encoding="utf-8"?>
<!--
    One detailed report (production, sales, inventory, stock distribution or rider performance):
    Daily | Weekly | Monthly filter, ◀ period ▶ navigator, summary tiles, a per-day chart and detail lists.
    Tiles and lists are filled in code from ReportContent.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl">

        <!-- ===== Header: back, title, period filter ===== -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_brand_header"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_sm"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Malunggay.PageTitle"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Sales report" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_segmented_track"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/dailyOption"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/reports_daily"
                    android:textAppearance="@style/TextAppearance.Malunggay.Title"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/weeklyOption"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/reports_weekly"
                    android:textAppearance="@style/TextAppearance.Malunggay.Title"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/monthlyOption"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/reports_monthly"
                    android:textAppearance="@style/TextAppearance.Malunggay.Title"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Period navigator: ◀ Nov 16 – 22 ▶ ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/previousButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/report_previous"
                android:rotation="180"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/colorOnSurface" />

            <LinearLayout
                android:id="@+id/periodLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xs">

                <TextView
                    android:id="@+id/periodText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.Malunggay.Title"
                    tools:text="Nov 16 – 22" />

                <TextView
                    android:id="@+id/periodCaptionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="This week" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/report_next"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- ===== Error banner ===== -->
        <LinearLayout
            android:id="@+id/errorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginEnd="@dimen/screen_padding"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_banner_error"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_error"
                app:tint="?attr/colorOnErrorContainer" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnErrorContainer"
                tools:text="Can't reach the server." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_retry"
                android:textColor="?attr/colorOnErrorContainer" />
        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_2xl"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- ===== Report body ===== -->
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Summary tiles: two per row, the headline one full width (added in code). -->
            <LinearLayout
                android:id="@+id/tilesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/screen_padding"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/chartCard"
                style="@style/Malunggay.SectionCard.Padded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chartTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Malunggay.Title"
                    tools:text="Pieces sold per day" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/report_chart_hint"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.example.malunggaytrackerapp.ui.common.BarChartView
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/emptyWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/space_md"
            android:visibility="gone">

            <include
                android:id="@+id/emptyState"
                layout="@layout/view_empty_state" />
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
