<?xml version="1.0" encoding="utf-8"?>
<!-- Admin › Reports: Daily | Monthly toggle, pieces-sold bar chart, links to the detailed screens. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl">

        <!-- ===== Header: title + period toggle ===== -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_brand_header"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/reports_title"
                android:textAppearance="@style/TextAppearance.Malunggay.Display"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:id="@+id/periodToggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_segmented_track"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/dailyOption"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_thumb"
                    android:gravity="center"
                    android:text="@string/reports_daily"
                    android:textAppearance="@style/TextAppearance.Malunggay.Title"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/weeklyOption"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/reports_weekly"
                    android:textAppearance="@style/TextAppearance.Malunggay.Title"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/monthlyOption"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/reports_monthly"
                    android:textAppearance="@style/TextAppearance.Malunggay.Title"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Error banner ===== -->
        <LinearLayout
            android:id="@+id/errorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginEnd="@dimen/screen_padding"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_banner_error"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_error"
                app:tint="?attr/colorOnErrorContainer" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnErrorContainer"
                tools:text="Can't reach the server." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_retry"
                android:textColor="?attr/colorOnErrorContainer" />
        </LinearLayout>

        <!-- ===== Pieces sold chart ===== -->
        <LinearLayout
            style="@style/Malunggay.SectionCard.Padded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reports_pieces_sold"
                    android:textAppearance="@style/TextAppearance.Malunggay.Title" />

                <TextView
                    android:id="@+id/rangeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Malunggay.Body"
                    tools:text="Last 7 days" />
            </LinearLayout>

            <TextView
                android:id="@+id/totalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Malunggay.Body"
                tools:text="1,240 pcs · ₱3,720.00" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <com.example.malunggaytrackerapp.ui.common.BarChartView
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/chartProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="28dp" />
            </FrameLayout>
        </LinearLayout>

        <!-- ===== Reports ===== -->
        <LinearLayout
            android:id="@+id/reportLinks"
            style="@style/Malunggay.SectionCard.List"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:divider="@drawable/divider_inset"
            android:orientation="vertical"
            android:showDividers="middle">

            <include
                android:id="@+id/productionReport"
                layout="@layout/item_report_link" />

            <include
                android:id="@+id/salesReport"
                layout="@layout/item_report_link" />

            <include
                android:id="@+id/inventoryReport"
                layout="@layout/item_report_link" />

            <include
                android:id="@+id/distributionReport"
                layout="@layout/item_report_link" />

            <include
                android:id="@+id/riderPerformanceReport"
                layout="@layout/item_report_link" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
