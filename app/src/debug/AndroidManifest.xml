<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: talk to the local Laravel server. Release builds stay HTTPS-only and never touch the LAN. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Android 17 (API 37) blocks apps from private/LAN addresses (10.0.2.2, 192.168.x.x, ...)
        unless this runtime permission is granted. Without it, requests silently time out.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
