<?xml version="1.0" encoding="utf-8"?>
<!-- Content of the "Price per piece" dialog: one ₱ amount field. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/space_xl">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/priceLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/price_dialog_hint"
        app:helperText="@string/price_dialog_helper"
        app:prefixText="@string/price_currency_prefix"
        app:suffixText="@string/price_per_pc_suffix">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/priceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="numberDecimal"
            android:maxLength="8"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
