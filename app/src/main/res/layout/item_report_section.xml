<?xml version="1.0" encoding="utf-8"?>
<!-- A titled list inside a report; rows (item_report_row) are added to rowsContainer in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/sectionTitle"
        style="@style/Malunggay.SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="By rider" />

    <LinearLayout
        android:id="@+id/rowsContainer"
        style="@style/Malunggay.SectionCard.List"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/divider_inset"
        android:orientation="vertical"
        android:showDividers="middle" />
</LinearLayout>
