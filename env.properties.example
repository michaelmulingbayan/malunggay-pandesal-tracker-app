# Copy this file to env.properties (git-ignored) and adjust the values.
# Rebuild / Sync Gradle after changing them. URLs must end with a slash.

# Emulator -> your PC: http://10.0.2.2:8000/
# Real phone on same Wi-Fi -> your PC's IP, e.g. http://192.168.1.10:8000/
API_BASE_URL_DEBUG=http://10.0.2.2:8000/

# Production API (must be HTTPS)
API_BASE_URL_RELEASE=https://api.example.com/
