<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Malunggay design system — light theme.
        Color roles map the emerald palette onto Material 3. Component defaults
        (inputs, buttons, cards) are set here once so every screen looks the same.
    -->
    <style name="Base.Theme.MalunggayTrackerApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/emerald_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/emerald_100</item>
        <item name="colorOnPrimaryContainer">@color/emerald_900</item>
        <item name="colorSecondary">@color/emerald_800</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/emerald_50</item>
        <item name="colorOnSecondaryContainer">@color/emerald_900</item>
        <item name="colorTertiary">@color/emerald_600</item>
        <item name="colorOnTertiary">@color/white</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/neutral_50</item>
        <item name="colorOnBackground">@color/neutral_900</item>
        <item name="colorSurface">@color/neutral_0</item>
        <item name="colorOnSurface">@color/neutral_900</item>
        <item name="colorSurfaceVariant">@color/neutral_100</item>
        <item name="colorOnSurfaceVariant">@color/neutral_600</item>
        <item name="colorSurfaceContainerLowest">@color/neutral_0</item>
        <item name="colorSurfaceContainerLow">@color/neutral_0</item>
        <item name="colorSurfaceContainer">@color/neutral_50</item>
        <item name="colorSurfaceContainerHigh">@color/neutral_100</item>
        <item name="colorSurfaceContainerHighest">@color/neutral_200</item>
        <item name="colorOutline">@color/neutral_300</item>
        <item name="colorOutlineVariant">@color/neutral_200</item>

        <!-- Feedback -->
        <item name="colorError">@color/red_600</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/red_100</item>
        <item name="colorOnErrorContainer">@color/red_800</item>

        <!-- Clean surfaces: no brand-colored tint on elevated cards/sheets. -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- Component defaults -->
        <item name="textInputStyle">@style/Widget.Malunggay.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Widget.Malunggay.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Malunggay.Card</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.Malunggay.CircularProgress</item>

        <!-- Edge-to-edge: content draws behind transparent system bars. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.MalunggayTrackerApp" parent="Base.Theme.MalunggayTrackerApp" />

    <!-- ===== Components ===== -->

    <style name="Widget.Malunggay.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="startIconTint">@color/input_icon</item>
        <item name="endIconTint">@color/input_icon</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.Malunggay.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textAppearance">@style/TextAppearance.Malunggay.Button</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.Malunggay.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="android:textAppearance">@style/TextAppearance.Malunggay.Button</item>
    </style>

    <style name="Widget.Malunggay.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Malunggay.CircularProgress" parent="Widget.Material3.CircularProgressIndicator.Small">
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="trackThickness">3dp</item>
    </style>

    <!-- ===== Typography ===== -->

    <style name="TextAppearance.Malunggay.Display" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Malunggay.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Malunggay.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.Malunggay.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Malunggay.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
